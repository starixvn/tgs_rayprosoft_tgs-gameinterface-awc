<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net7.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<Version>0.0.12</Version>
		<Authors>Raypro</Authors>
		<Description>Tgs GameInterface AwcService Client</Description>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-awcservice</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-awcservice.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Tgs GameInterface AwcService</PackageTags>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Protos\**" />
	  <EmbeddedResource Remove="Protos\**" />
	  <None Remove="Protos\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.55.0" />
		<PackageReference Include="Grpc.Net.ClientFactory" Version="2.55.0" />
		<PackageReference Include="Grpc.Tools" Version="2.56.2">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
	</ItemGroup>

	<ItemGroup>
	  <Protobuf Include="..\Tgs.GameInterface.AwcService\Protos\gameinterfaceawcrecordservice.proto" GrpcServices="Client">
	    <Link>gameinterfaceawcrecordservice.proto</Link>
	  </Protobuf>
	  <Protobuf Include="..\Tgs.GameInterface.AwcService\Protos\gameinterfaceawcservice.proto" GrpcServices="Client">
	    <Link>gameinterfaceawcservice.proto</Link>
	  </Protobuf>
	</ItemGroup>

</Project>
