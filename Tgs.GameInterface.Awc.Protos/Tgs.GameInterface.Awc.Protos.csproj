<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="gameinterfaceawc.proto" />
    <None Remove="gameinterfaceawcrecord.proto" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.63.0" />
    <PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.7" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="gameinterfaceawc.proto" GrpcServices="Both" />
    <Protobuf Include="gameinterfaceawcrecord.proto" GrpcServices="Both" />
  </ItemGroup>

</Project>
